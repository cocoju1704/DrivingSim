!/requirements.txt
!/_Experiment/
/_Experiment/wheel_buttons.json
!/carla-audio-engine/
/carla-audio-engine/logs/
!/TORApp/

!/PythonAPI/
/PythonAPI/*
!/PythonAPI/examples/
/PythonAPI/examples/*
!/PythonAPI/examples/analyze_takeover.py

__pycache__/
