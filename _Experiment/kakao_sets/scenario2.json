  "followup": [
    {"from": "노 사원", "text": "방금 식당에서 연락 왔는데 2층 단체룸이 공사 중이라 3층 룸으로 옮겨진대요"},
    {"from": "정 대리", "text": "그리고 대표님이 8시쯤 잠깐 들르신대요!"},
    {"from": "박 차장", "text": "아 그렇군요 룸은 3층으로 가면 되겠네요"},
    {"from": "박 차장", "text": "그리고 재무팀에서 연락 왔는데 법인카드 지원이 1인 3만원으로 줄었대요 ㅠ"},
    {"from": "한 대리", "text": "헉 대표님 오시면 다들 늦으면 안 되겠네요"},
    {"from": "길 인턴", "text": "신입분들 선물도 준비하나요?"},
    {"from": "노 사원", "text": "지원 줄어든 건 아쉽네요 ㅠㅠ 그래도 신입분들은 회비 안 받는 거 맞죠?", "tag": "D"},
    {"from": "유 부장", "text": "선물은 팀비로 내가 준비할게요. 공지에는 안 넣어도 돼요"},
    {"from": "노 사원", "text": "정산 때문에 회비는 원래 마감보다 하루 일찍 받을게요!", "tag": "E"},
    {"from": "유 부장", "text": "신입은 팀비로 처리해요", "tag": "D"},
    {"from": "유 부장", "text": "그리고 대표님 오시니까 운영 파트도 회의 미루고 시작할 때 맞춰 오세요", "tag": "A"},
    {"from": "박 차장", "text": "{name} 사원 추가사항까지 반영해서 공지 마저 작성해서 올려주세요~"}
