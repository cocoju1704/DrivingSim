{
  "title": "신입사원 환영 회식 공지",
  "room": "마케팅팀",
  "member_count": 7,
  "task": "마케팅팀 단톡방 대화를 정리해 신입사원 환영 회식 공지를 작성한다. 팀원들이 공지 하나만 보고 준비할 수 있어야 한다.",
  "messages": [
    {"t": -85, "from": "유 부장", "text": "이번에 신입사원 세 명 들어온 거 다들 알죠? 환영 회식 합시다"},
    {"t": -84, "from": "박 차장", "text": "날짜는 12월 5일 금요일 어떠세요?"},
    {"t": -84, "from": "정 대리", "text": "신입분들 이름이 서지훈, 문하은, 임도윤 씨 맞죠?"},
    {"t": -83, "from": "유 부장", "text": "좋아요 5일(금)로 하죠"},
    {"t": -83, "from": "박 차장", "text": "네 맞아요. 셋 다 기획 파트로 왔어요"},
    {"t": -80, "from": "한 대리", "text": "장소는 어디로 할까요? 강남역 쪽이 다들 편할 것 같은데"},
    {"t": -79, "from": "정 대리", "text": "디자인팀은 12일에 회식한다던데 우리가 먼저네요 ㅎㅎ", "tag": "B"},
    {"t": -79, "from": "노 사원", "text": "강남역 한우마을 어때요? 지난번 회식 때 좋았잖아요 🥩"},
    {"t": -78, "from": "정 대리", "text": "역삼역 고깃집도 괜찮던데요", "tag": "B"},
    {"t": -75, "from": "박 차장", "text": "한우마을 2층 단체룸 예약했어요. 6시 반으로 해뒀습니다"},
    {"t": -75, "from": "길 인턴", "text": "와 한우 ㅠㅠ"},
    {"t": -72, "from": "정 대리", "text": "회비는 어떻게 돼요?"},
    {"t": -70, "from": "박 차장", "text": "아 방금 식당에서 연락 왔는데 앞 팀 때문에 7시부터 룸 쓸 수 있대요"},
    {"t": -69, "from": "유 부장", "text": "그럼 7시에 시작합시다"},
    {"t": -68, "from": "박 차장", "text": "회비는 코스가 1인 6만원인데 법인카드로 1인 4만원까지 지원돼요. 나머지는 각자 부담이요"},
    {"t": -67, "from": "한 대리", "text": "운영 파트는 그날 6시에 마감 회의가 있어서요 ㅠ", "tag": "D"},
    {"t": -66, "from": "한 대리", "text": "지난번엔 5만원 코스였는데 이번엔 좀 비싸네요", "tag": "B"},
    {"t": -64, "from": "유 부장", "text": "운영 파트는 회의 끝나고 30분 늦게 와도 돼요", "tag": "D"},
    {"t": -60, "from": "유 부장", "text": "시작하면 신입들 자기소개 한 사람당 3분씩 하고, 건배사는 내가 할게요"},
    {"t": -59, "from": "노 사원", "text": "회비는 제가 총무라 걷을게요! 회식 이틀 전까지 저한테 카카오페이로 보내주세요", "tag": "E"},
    {"t": -58, "from": "길 인턴", "text": "저도 입사 때 자기소개 했었는데 엄청 떨렸어요 ㅋㅋ"},
    {"t": -58, "from": "정 대리", "text": "넵넵"},
    {"t": -52, "from": "정 대리", "text": "끝나고 2차로 볼링 어때요? 🎳"},
    {"t": -51, "from": "한 대리", "text": "끝나는 시간은요? 막차 걱정돼서요"},
    {"t": -50, "from": "유 부장", "text": "2차는 희망자만 따로 가는 걸로 하고 공지에는 넣지 맙시다"},
    {"t": -49, "from": "박 차장", "text": "9시 반쯤 마무리하면 어떨까요?", "tag": "C"},
    {"t": -49, "from": "노 사원", "text": "혹시 주차되나요?", "tag": "C"},
    {"t": -48, "from": "박 차장", "text": "주차는 안 돼요. 대중교통 이용해주세요"},
    {"t": -40, "from": "박 차장", "text": "회식 사진은 사내보에 올릴 건데 싫은 분은 저한테 개인적으로 말해주세요", "tag": "F"},
    {"t": -32, "from": "한 대리", "text": "근데 오늘 점심 김치찌개 진짜 맛있지 않았어요? ㅋㅋ"},
    {"t": -31, "from": "노 사원", "text": "인정이요 내일 또 가요 ㅋㅋ"},
    {"t": -24, "from": "박 차장", "text": "식당에서 또 연락 왔는데 앞 팀이 취소해서 처음 예약한 시간에 룸 쓸 수 있대요", "tag": "A"},
    {"t": -23, "from": "유 부장", "text": "그럼 시작은 원래대로 합시다", "tag": "A"},
    {"t": -22, "from": "길 인턴", "text": "넵!"},
    {"t": 0, "from": "박 차장", "text": "{name} 사원 그러면 회의내용 정리해서 이 단톡방에 공지로 {deadline}(10분 뒤)까지 꼭 올려주세요~"}
  ],
